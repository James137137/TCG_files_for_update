    const content = [{ type: 'text', text: JSON.stringify(result) }];
    if (name === 'screenshot') {
      const captureRoot = path.join(root, 'captures') + path.sep;
      if (!path.resolve(result.path).startsWith(captureRoot)) throw new Error('Screenshot path escaped the session captures directory.');
      content.push({ type: 'image', mimeType: 'image/png', data: (await fs.readFile(result.path)).toString('base64') });
    }
    return { content, structuredContent: result };
  } catch (error) {
    const message = error.message;
    const next = /pending choices|pending effects|pending.*choice/i.test(message) ? 'Inspect get_state.seat0/seat1.actions and dispatch the actual choice. Do not end a turn to clear an unknown choice.'
