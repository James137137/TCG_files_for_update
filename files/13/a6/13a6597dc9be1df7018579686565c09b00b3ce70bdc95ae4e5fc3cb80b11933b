server.setRequestHandler(CallToolRequestSchema, async request => {
  const { name, arguments: args = {} } = request.params;
  if (!tools.some(t => t.name === name)) return { isError: true, content: [{ type: 'text', text: `Unknown tool: ${name}` }] };
  const validate = validators.get(name);
  if (!validate(args)) return { isError: true, content: [{ type: 'text', text: 'Invalid tool arguments: ' + ajv.errorsText(validate.errors) }] };
  try {
    const normalized = args.overrides ? { ...args, overrides: { ...args.overrides, hasMaxHp: Object.hasOwn(args.overrides, 'maxHp'), hasTypes: Object.hasOwn(args.overrides, 'types'), hasWeaknesses: Object.hasOwn(args.overrides, 'weaknesses'), hasResistances: Object.hasOwn(args.overrides, 'resistances'), types: args.overrides.types ?? [], attacks: args.overrides.attacks ?? [], weaknesses: args.overrides.weaknesses ?? [], resistances: args.overrides.resistances ?? [] } } : args;
