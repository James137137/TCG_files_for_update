      : /selection/i.test(message) ? 'Open the picker again and use its new selectionId.' : 'Inspect get_session/get_card before retrying and check the schema. A presentation error can occur after a state commit; verify the actual state.';
    return { isError: true, content: [{ type: 'text', text: message + '\nNext step: ' + next }], structuredContent: { error: message, nextStep: next } };
  }
